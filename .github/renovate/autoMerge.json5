{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      matchDatasources: [
        "docker",
        "github-tags"
      ],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
      platformCommit: true,
      matchUpdateTypes: [
        "minor",
        "patch",
      ],
      matchPackageNames: [
        "ghcr.io/larivierec/cloudflare-ddns",
        "codeberg.org/k8s-gateway/k8s_gateway"
      ]
    },
  ]
}
